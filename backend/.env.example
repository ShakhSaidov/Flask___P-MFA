LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Optional Groq reasoning budget for gpt-oss models: low, medium, high
# GROQ_REASONING_EFFORT=medium

# Optional 100% offline local fallback (requires Ollama running on localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Optional Flask runtime flags
# FLASK_DEBUG=false
# TRUST_PROXY=false
